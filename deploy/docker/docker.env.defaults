APP_NAME=ogfashions
APP_ENV=production

# Permanent public domain for production (`lp`) only.
# For `l1`, `l2`, `l3`, or `l6`, override this with an IP/load balancer URL or leave it empty.
APP_PUBLIC_BASE_URL=https://ogstyles.store

# Database
MYSQL_DATABASE=ecommerce
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# CORS
APP_CORS_ALLOWED_ORIGINS=https://ogstyles.store,https://www.ogstyles.store,http://127.0.0.1:5500,http://localhost:5500
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://*.compute.amazonaws.com,https://*.compute.amazonaws.com,http://*.elb.amazonaws.com,https://*.elb.amazonaws.com

# Bootstrap admin
APP_BOOTSTRAP_ADMIN_ENABLED=true
APP_BOOTSTRAP_ADMIN_NAME=Platform Admin
APP_BOOTSTRAP_ADMIN_EMAIL=contact.ogfashions@gmail.com

# Mail
APP_MAIL_ENABLED=true
APP_MAIL_FROM=contact.ogfashions@gmail.com
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=contact.ogfashions@gmail.com
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true

# Frontend -> backend routing inside the Docker network.
BACKEND_UPSTREAM=http://ogfashions-backend:8888
BACKEND_HOST_PORT=8888
FRONTEND_HOST_PORT=80
PORT_CONFLICT_STRATEGY=fail
PORT_SEARCH_LIMIT=25

# Build behavior
IMAGE_TAG=latest
BACKEND_IMAGE=
FRONTEND_IMAGE=
BUILD_IMAGES_LOCALLY=true
