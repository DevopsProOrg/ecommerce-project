APP_NAME=ogfashions
MYSQL_DATABASE=ecommerce
MYSQL_ROOT_PASSWORD=change-this-mysql-root-password
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-this-mysql-root-password
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_JPA_HIBERNATE_DDL_AUTO=update
APP_CORS_ALLOWED_ORIGINS=http://YOUR_EC2_PUBLIC_DNS,http://YOUR_DOMAIN
APP_BOOTSTRAP_ADMIN_ENABLED=true
APP_BOOTSTRAP_ADMIN_NAME=Platform Admin
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=ChangeThisImmediately123!
APP_MAIL_ENABLED=true
APP_MAIL_FROM=contact.ogfashions@gmail.com
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=contact.ogfashions@gmail.com
SPRING_MAIL_PASSWORD=replace-with-gmail-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
BACKEND_UPSTREAM=http://ogfashions-backend:8888
